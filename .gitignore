# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Spreadsheet lock files
.~lock*

# Kaggle competition data (download from Kaggle)
kaggle/

# Analysis exports that contain rows of the competition data (regenerated by error_analysis.py)
errors_female_3rd_class.csv
female_3rd_class.csv

# Personal notes, kept local
assessment_after_first_solution.txt

# Virtual environments inside project folders
venv/

# Local SQLite databases (created at runtime)
*.db

# Course materials (Pluralsight downloads: copyrighted, kept local)
fast-api fundamentals/
# Saved models (rebuilt by save_model(); versions go to MLflow later)
*.joblib
# MLflow's logged models and files (rebuilt by train_and_log(); the runs and registry are in mlflow.db, ignored above)
mlruns/
# The champion model downloaded for the API image (rebuilt by credit-api/fetch_champion.py)
credit-api/model/

# editor settings
.vscode/
# a course demo environment, not a project
mlops-mlflow-demo/
# GPT from scratch: the downloaded book and the training text extracted from it (download from Gutenberg, rebuild with extract_text.py)
gpt-from-scratch/input.txt
gpt-from-scratch/*.html
gpt-from-scratch/*.epub
gpt-from-scratch/*.pdf
gpt-from-scratch/output.txt
gpt-from-scratch/model.pt

# Hugging Face demo: Trainer checkpoints (GBs) and run output
hugging-face-demo/test-trainer/
hugging-face-demo/bert-mrpc/
hugging-face-demo/output.txt

# Disaster Tweets: run output
disaster-tweets/output.txt
disaster-tweets/logs/

# Disaster Tweets: Trainer output folder (checkpoints, if any)
disaster-tweets/bert_runs/
disaster-tweets/trainer_output/
